---
import { Image } from 'astro:assets';
import aboutData from '../content/about.ts';
import profileImage from '../assets/profile.webp';
import { FaProjectDiagram, FaHandshake } from 'react-icons/fa';
---

<section id="about" class="max-w-6xl mx-auto px-6 py-24 border-t border-slate-100 dark:border-slate-900">
  <div class="mb-14" data-aos="fade-right">
    <h2 class="text-sm font-bold tracking-[0.3em] text-blue-600 dark:text-blue-400 uppercase mb-2">Ringkasan</h2>
    <h3 class="text-4xl font-black text-slate-900 italic dark:text-white">Tentang Saya.</h3>
  </div>

  <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div data-aos="fade-right" class="relative">
      <div class="aspect-square bg-slate-100 dark:bg-slate-900 rounded-2xl overflow-hidden relative group shadow-xl">
        <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/20 to-transparent dark:from-blue-500/10 z-10 group-hover:opacity-60 transition-opacity"></div>

        <Image
          src={profileImage}
          alt="Foto Profil"
          width={600}
          height={600}
          format="avif"
          quality="high"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </div>

      <div class="absolute -bottom-6 -right-6 bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-xl dark:shadow-blue-900/20 border border-slate-100 dark:border-blue-500/20 z-20" data-aos="zoom-in" data-aos-delay="500">
        <span class="block text-3xl font-black text-blue-600 dark:text-blue-400">{new Date().getFullYear() - 2022}+</span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Years Exp.</span>
      </div>

      <div class="absolute -top-4 -left-4 w-24 h-24 bg-blue-500/5 dark:bg-blue-400/5 rounded-full blur-2xl pointer-events-none"></div>
    </div>

    <div data-aos="fade-left" class="text-center md:text-left">
      <h3 class="text-3xl md:text-4xl font-black mb-6 leading-tight text-slate-900 dark:text-white">
        {aboutData.title}
      </h3>

      <p class="text-slate-600 dark:text-slate-400 mb-8 leading-relaxed text-lg md:text-base">
        {aboutData.description}
      </p>

      <div class="flex flex-wrap justify-center md:justify-start gap-4">
        <div class="flex gap-6 p-5 bg-white dark:bg-slate-900/30 border border-slate-100 dark:border-slate-800/60 rounded-2xl shadow-sm hover:shadow-md hover:border-blue-500/20 hover:bg-slate-50/50 dark:hover:bg-slate-900/50 transition-all duration-300">
          {aboutData.stats.map((stat, index) => (
            <Fragment key={index}>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-blue-600 dark:text-blue-400">
                  {index === 0 ? <FaProjectDiagram class="text-sm" /> : <FaHandshake class="text-sm" />}
                </div>
                <div class="text-left">
                  <p class="font-black text-xl text-slate-900 dark:text-white">{stat.value}</p>
                  <p class="text-[9px] font-bold uppercase tracking-tight text-slate-400 dark:text-slate-500">{stat.label}</p>
                </div>
              </div>
              {index === 0 && <div class="w-px bg-slate-200 dark:bg-slate-700" />}
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

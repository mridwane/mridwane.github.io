---
import { Image } from 'astro:assets';
import aboutData from '../content/about.ts';
import profileImage from '../assets/profile.webp';
---

<section id="about" class="max-w-5xl mx-auto px-6 py-24 border-t border-slate-100 dark:border-slate-900">
  <div class="mb-14" data-aos="fade-right">
    <h2 class="text-sm font-bold tracking-[0.3em] text-blue-600 dark:text-blue-400 uppercase mb-2">Ringkasan</h2>
    <h3 class="text-4xl font-black text-slate-900 italic dark:text-white">Tentang Saya.</h3>
  </div>

  <div class="grid md:grid-cols-12 gap-10 md:gap-14" data-aos="fade-up">
    <div class="md:col-span-5 flex justify-center md:justify-start">
      <div class="relative group">
        <div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden shadow-lg group-hover:shadow-xl transition-shadow duration-300">
          <Image
            src={profileImage}
            alt="Foto Profil"
            width={600}
            height={600}
            format="avif"
            quality="high"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </div>
        <div class="absolute -bottom-3 left-4 right-4 h-0.5 bg-gradient-to-r from-blue-600/60 to-cyan-500/60 rounded-full"></div>
      </div>
    </div>

    <div class="md:col-span-7 flex flex-col justify-center">
      <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-blue-600 dark:text-blue-400 mb-3 block text-center md:text-left">Fullstack Developer</span>

      <h3 class="text-3xl md:text-4xl font-black mb-5 leading-tight text-slate-900 dark:text-white text-center md:text-left">
        {aboutData.title}
      </h3>

      <p class="text-slate-600 dark:text-slate-400 mb-8 leading-relaxed text-base text-center md:text-left">
        {aboutData.description}
      </p>

      <div class="flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-3 pt-6 border-t border-slate-100 dark:border-slate-800">
        {aboutData.stats.map((stat, index) => (
          <div key={index} class="flex items-center gap-3">
            <span class="text-2xl font-black text-slate-900 dark:text-white tabular-nums">{stat.value}</span>
            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">{stat.label}</span>
            {index === 0 && <span class="text-slate-200 dark:text-slate-700">/</span>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

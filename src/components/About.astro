---
import { Image } from 'astro:assets';
import aboutData from '../content/about.ts';
import profileImage from '../assets/profile.webp';
import { FaProjectDiagram, FaHandshake } from 'react-icons/fa';
---

<section id="about" class="max-w-5xl mx-auto px-6 py-24 border-t border-slate-100 dark:border-slate-900">
  <div class="mb-12" data-aos="fade-right">
    <h2 class="text-sm font-bold tracking-[0.3em] text-blue-600 dark:text-blue-400 uppercase mb-2">Ringkasan</h2>
    <h3 class="text-4xl font-black text-slate-900 italic dark:text-white">Tentang Saya.</h3>
  </div>

  <div class="relative bg-white dark:bg-slate-900/20 border border-slate-100 dark:border-slate-800/60 rounded-2xl overflow-hidden group hover:shadow-xl hover:border-blue-500/20 transition-all duration-300" data-aos="fade-up">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-blue-500/[0.03] to-transparent dark:from-blue-400/[0.03] pointer-events-none"></div>
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-blue-500/5 dark:bg-blue-400/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative grid md:grid-cols-5 gap-8 p-8 md:p-10">
      <div class="md:col-span-2 flex justify-center md:justify-start" data-aos="zoom-in">
        <div class="relative">
          <div class="absolute -inset-3 rounded-2xl bg-gradient-to-br from-blue-600/10 to-cyan-500/10 dark:from-blue-400/10 dark:to-cyan-300/10 -z-10 group-hover:scale-105 transition-transform duration-500"></div>
          <div class="absolute -inset-4 rounded-2xl border border-blue-100 dark:border-blue-500/10 -z-20"></div>

          <div class="w-56 h-56 md:w-60 md:h-60 rounded-2xl overflow-hidden shadow-xl group-hover:shadow-2xl transition-shadow duration-300">
            <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/20 to-transparent dark:from-blue-500/10 z-10 group-hover:opacity-60 transition-opacity"></div>
            <Image
              src={profileImage}
              alt="Foto Profil"
              width={600}
              height={600}
              format="avif"
              quality="high"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>

          <div class="absolute -bottom-4 -right-4 bg-white dark:bg-slate-800 px-4 py-3 rounded-xl shadow-lg dark:shadow-blue-900/20 border border-slate-100 dark:border-blue-500/20 z-20">
            <span class="block text-xl font-black text-blue-600 dark:text-blue-400">{new Date().getFullYear() - 2022}+</span>
            <span class="text-[8px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Years Exp.</span>
          </div>
        </div>
      </div>

      <div class="md:col-span-3 flex flex-col justify-center text-center md:text-left" data-aos="fade-left">
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-blue-600 dark:text-blue-400 mb-3">Fullstack Developer</span>

        <h3 class="text-3xl md:text-4xl font-black mb-5 leading-tight text-slate-900 dark:text-white">
          {aboutData.title}
        </h3>

        <p class="text-slate-600 dark:text-slate-400 mb-7 leading-relaxed text-base md:text-base">
          {aboutData.description}
        </p>

        <div class="inline-flex flex-wrap justify-center md:justify-start gap-5 p-5 bg-slate-50/50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-800/60 rounded-xl">
          {aboutData.stats.map((stat, index) => (
            <Fragment key={index}>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0">
                  {index === 0 ? <FaProjectDiagram class="text-xs" /> : <FaHandshake class="text-xs" />}
                </div>
                <div class="text-left">
                  <p class="font-black text-lg text-slate-900 dark:text-white">{stat.value}</p>
                  <p class="text-[8px] font-bold uppercase tracking-tight text-slate-400 dark:text-slate-500">{stat.label}</p>
                </div>
              </div>
              {index === 0 && <div class="w-px bg-slate-200 dark:bg-slate-700" />}
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

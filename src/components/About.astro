---
import { Image } from 'astro:assets';
import aboutData from '../content/about.ts';
import profileImage from '../assets/profile.webp';
import { FaProjectDiagram, FaHandshake, FaQuoteLeft } from 'react-icons/fa';
---

<section id="about" class="max-w-5xl mx-auto px-6 py-24 border-t border-slate-100 dark:border-slate-900">
  <div class="mb-12" data-aos="fade-right">
    <h2 class="text-sm font-bold tracking-[0.3em] text-blue-600 dark:text-blue-400 uppercase mb-2">Ringkasan</h2>
    <h3 class="text-4xl font-black text-slate-900 italic dark:text-white">Tentang Saya.</h3>
  </div>

  <div class="relative bg-white dark:bg-slate-900/20 border border-slate-100 dark:border-slate-800/60 rounded-2xl overflow-hidden group hover:shadow-xl hover:border-blue-500/20 transition-all duration-300" data-aos="fade-up">
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-600 to-cyan-500 opacity-60"></div>
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-blue-500/5 dark:bg-blue-400/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-cyan-500/5 dark:bg-cyan-400/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative grid md:grid-cols-12 gap-8 p-8 md:p-12">
      <div class="md:col-span-5 flex justify-center md:justify-start items-start pt-2" data-aos="zoom-in">
        <div class="relative">
          <div class="absolute -inset-4 rounded-full bg-gradient-to-br from-blue-600/15 to-cyan-500/15 dark:from-blue-400/20 dark:to-cyan-300/20 -z-10 blur-sm group-hover:scale-110 transition-transform duration-700"></div>
          <div class="absolute -inset-2 rounded-full border-2 border-blue-100 dark:border-blue-500/20 -z-20 group-hover:border-blue-300 dark:group-hover:border-blue-400/40 transition-colors duration-500"></div>

          <div class="w-52 h-52 md:w-56 md:h-56 rounded-full overflow-hidden shadow-xl group-hover:shadow-2xl transition-shadow duration-300 ring-4 ring-white dark:ring-slate-800">
            <div class="absolute inset-0 bg-gradient-to-t from-blue-600/30 to-transparent dark:from-blue-500/20 z-10 group-hover:opacity-60 transition-opacity"></div>
            <Image
              src={profileImage}
              alt="Foto Profil"
              width={600}
              height={600}
              format="avif"
              quality="high"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
          </div>

          <div class="absolute -bottom-3 -right-3 bg-white dark:bg-slate-800 px-4 py-3 rounded-xl shadow-lg dark:shadow-blue-900/20 border border-slate-100 dark:border-blue-500/20 z-20 group-hover:shadow-xl transition-shadow duration-300">
            <span class="block text-xl font-black text-blue-600 dark:text-blue-400">{new Date().getFullYear() - 2022}+</span>
            <span class="text-[8px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Tahun</span>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 flex flex-col justify-center text-center md:text-left" data-aos="fade-left">
        <div class="flex items-center gap-2 justify-center md:justify-start mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
          <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-blue-600 dark:text-blue-400">Fullstack Developer</span>
        </div>

        <h3 class="text-3xl md:text-4xl font-black mb-6 leading-tight text-slate-900 dark:text-white">
          {aboutData.title}
        </h3>

        <div class="relative">
          <FaQuoteLeft class="absolute -top-1 -left-1 text-blue-200 dark:text-blue-800 text-lg md:text-xl opacity-50" />
          <p class="text-slate-600 dark:text-slate-400 mb-8 leading-relaxed text-base pl-6 md:pl-7 italic">
            {aboutData.description}
          </p>
        </div>

        <div class="flex flex-wrap justify-center md:justify-start gap-4">
          {aboutData.stats.map((stat, index) => (
            <div key={index} class="flex-1 min-w-[140px] p-4 bg-white dark:bg-slate-900/40 border border-slate-100 dark:border-slate-800/60 rounded-xl hover:shadow-md hover:border-blue-500/20 hover:bg-slate-50/50 dark:hover:bg-slate-900/50 transition-all duration-300 group/stat">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/30 dark:to-cyan-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0 group-hover/stat:scale-110 transition-transform duration-300">
                  {index === 0 ? <FaProjectDiagram class="text-xs" /> : <FaHandshake class="text-xs" />}
                </div>
                <div class="text-left">
                  <p class="font-black text-xl text-slate-900 dark:text-white">{stat.value}</p>
                  <p class="text-[8px] font-bold uppercase tracking-tight text-slate-400 dark:text-slate-500">{stat.label}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["fixed inset-0 -z-10 bg-white dark:bg-slate-950", className]}>
  <!-- Polka Dots Pattern -->
  <div class:list={[
    "absolute h-full w-full",
    "bg-[radial-gradient(#80808026_2px,transparent_2px)]",
    "dark:bg-[radial-gradient(#3b82f620_2px,transparent_2px)]",
    "bg-[size:40px_40px]",
    "[mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
  ]}></div>
  
  <div class="absolute inset-0 dark:bg-[radial-gradient(circle_at_50%_0%,rgba(59,130,246,0.05)_0%,transparent_50%)]"></div>
</div>

---
---
<section class="relative min-h-screen flex justify-center items-center text-center px-6 pt-20 overflow-hidden">

  <div data-aos="fade-up" data-aos-duration="1000" class="z-10">
    <span class="inline-flex items-center gap-2 px-4 py-1.5 text-[10px] font-bold tracking-[0.3em] uppercase bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400 rounded-full mb-3 border border-amber-200 dark:border-amber-500/30">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
      Under Construction
    </span>
    <span class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 rounded-full mb-6 border border-blue-100 dark:border-blue-800">
      Fullstack Developer
    </span>
    <h1 class="text-5xl md:text-8xl font-black mb-8 tracking-tighter leading-tight">
      <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-[1.4]">
        Menghidupkan <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300">Ide</span>
      </span>
      <br />
      <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-[1.4]">
        Lewat <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300">Baris Kode.</span>
      </span>
    </h1>
    <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg md:text-xl mb-10 mx-auto font-medium">
      <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-relaxed">
        Mengubah logika sistem yang kompleks menjadi pengalaman digital yang <span class="text-slate-900 dark:text-white underline decoration-blue-500 underline-offset-4 font-bold">intuitif, bersih, dan modern</span>.
      </span>
    </p>
    <div class="flex flex-col md:flex-row flex-wrap justify-center gap-4">
      <a href="#kontak" class="px-8 py-4 bg-slate-900 dark:bg-white dark:text-slate-950 text-white rounded-2xl font-bold hover:-translate-y-1 transition shadow-xl shadow-blue-500/10">Hubungi Saya</a>
      <a href="#experience" class="px-8 py-4 border border-slate-200 dark:border-slate-800 rounded-2xl font-bold hover:bg-slate-50 dark:hover:bg-slate-900 transition text-sm">Pengalaman</a>
    </div>
  </div>
</section>

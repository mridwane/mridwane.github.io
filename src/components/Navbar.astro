---
import { ModeToggle } from "./ModeToggle";
import { LanguageToggle } from "./LanguageToggle";

interface MenuItem {
  label: string;
  url: string;
  i18nKey: string;
}

const menuItems: MenuItem[] = [
  { label: 'About', url: '/#about', i18nKey: 'nav.about' },
  { label: 'Skills', url: '/#skills', i18nKey: 'nav.skills' },
  { label: 'Experience', url: '/#experience', i18nKey: 'nav.experience' },
  { label: 'Projects', url: '/project', i18nKey: 'nav.project' },
  { label: 'Showcase', url: '/showcase', i18nKey: 'nav.showcase' },
  { label: 'Contact', url: '/kontak', i18nKey: 'nav.contact' },
];
---
<nav class="fixed top-0 w-screen z-50 transition-all duration-300">
  <div class="absolute inset-0 bg-white/70 dark:bg-slate-950/80 backdrop-blur-xl border-b border-slate-200/50 dark:border-blue-500/10"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-black tracking-tighter uppercase italic group">
      <span class="text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <span class="text-blue-600 dark:text-blue-400">MRIDWANE</span>
      </span>
    </a>

    <div class="flex items-center gap-4">
      <div class="hidden md:flex gap-8 text-[10px] font-semibold uppercase tracking-[0.2em]">
        {menuItems.map((item) => (
          <a href={item.url} data-nav={item.url} data-i18n={item.i18nKey} class="nav-link relative text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300 group">
            {item.label}
            <span class="nav-indicator absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 dark:bg-blue-400 transition-all duration-300 group-hover:w-full shadow-[0_0_8px_rgba(37,99,235,0.6)]"></span>
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2 pl-6 border-l border-slate-200 dark:border-slate-800">
        <LanguageToggle client:visible />
        <ModeToggle client:visible />
      </div>

      <button id="menu-btn" class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus:outline-none z-50 group" aria-label="Toggle Menu">
        <span class="block w-6 h-0.5 bg-slate-900 dark:bg-white transition-all duration-300 origin-center group-hover:bg-blue-600 dark:group-hover:bg-blue-400"></span>
        <span class="block w-6 h-0.5 bg-slate-900 dark:bg-white transition-all duration-300 origin-center group-hover:bg-blue-600 dark:group-hover:bg-blue-400"></span>
        <span class="block w-6 h-0.5 bg-slate-900 dark:bg-white transition-all duration-300 origin-center group-hover:bg-blue-600 dark:group-hover:bg-blue-400"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-40 bg-white/95 dark:bg-slate-950/95 backdrop-blur-xl transform translate-x-full transition-transform duration-300 flex flex-col justify-center items-center md:hidden">
    <div class="flex flex-col gap-8 text-center">
      {menuItems.map((item) => (
        <a href={item.url} data-nav={item.url} data-i18n={item.i18nKey} class="mobile-link text-2xl font-bold uppercase tracking-widest text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const spans = menuBtn?.querySelectorAll('span');
  const navLinks = document.querySelectorAll('[data-nav]');
  let isMenuOpen = false;
  let previousOverflow = '';

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;

    if (isMenuOpen) {
      mobileMenu?.classList.remove('translate-x-full');
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      if (spans) {
        spans[0].classList.add('rotate-45', 'translate-y-2');
        spans[1].classList.add('opacity-0');
        spans[2].classList.add('-rotate-45', '-translate-y-2');
      }
    } else {
      mobileMenu?.classList.add('translate-x-full');
      document.body.style.overflow = previousOverflow;
      previousOverflow = '';

      if (spans) {
        spans[0].classList.remove('rotate-45', 'translate-y-2');
        spans[1].classList.remove('opacity-0');
        spans[2].classList.remove('-rotate-45', '-translate-y-2');
      }
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });

  const nav = document.querySelector('nav');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 50) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
    lastScroll = currentScroll;
  }, { passive: true });

  function setActive(activeUrl) {
    navLinks.forEach(link => {
      const linkUrl = link.getAttribute('data-nav');
      const isActive = activeUrl !== null && linkUrl === activeUrl;
      link.classList.toggle('text-blue-600', isActive);
      link.classList.toggle('dark:text-blue-400', isActive);
      link.classList.toggle('text-slate-600', !isActive);
      link.classList.toggle('dark:text-slate-400', !isActive);
    });
  }

  function updateActive() {
    const path = window.location.pathname;
    const hash = window.location.hash;

    if (path === '/project' || path.startsWith('/project/')) {
      setActive('/project');
      return;
    }
    if (path === '/showcase') {
      setActive('/showcase');
      return;
    }
    if (path === '/kontak') {
      setActive('/kontak');
      return;
    }

    if (path === '/') {
      const navHash = hash ? `/${hash}` : null;
      if (navHash && ['/#about', '/#skills', '/#experience'].includes(navHash)) {
        setActive(navHash);
        return;
      }
      setActive(null);
      return;
    }

    setActive(null);
  }

  updateActive();

  if (window.location.pathname === '/') {
    const sectionIds = ['about', 'skills', 'experience'];
    const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

    function checkActiveSection() {
      const offset = window.innerHeight * 0.35;
      const scrollTop = window.scrollY + offset;
      let activeId = null;

      for (const el of sections) {
        const top = el.offsetTop;
        const bottom = top + el.offsetHeight;
        if (scrollTop >= top && scrollTop < bottom) {
          activeId = el.id;
          break;
        }
      }

      setActive(activeId ? `/#${activeId}` : null);
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { ticking = false; checkActiveSection(); });
        ticking = true;
      }
    }, { passive: true });

    checkActiveSection();
  }

  window.addEventListener('popstate', updateActive);
  window.addEventListener('hashchange', updateActive);
</script>

<style>
  nav.scrolled {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
</style>

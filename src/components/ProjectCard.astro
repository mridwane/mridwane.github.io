---
import type { ProjectCardProps } from '../types/project-card';

const {
  title,
  description,
  src,
  tags = [],
  liveUrl,
  detailUrl,
  delay = 0,
  loading = 'lazy',
  scale = 0.3,
  timeCount,
  timeUnit
} = Astro.props as ProjectCardProps;

const cleanedSrc = src.replace(/\?.*$/, '') + '?utm_source=portfolio';
const previewWidth = Math.round(100 / scale);
---

<article
  class="project-card"
  data-aos="fade-up"
  data-aos-delay={String(delay)}
>
  <div class="bg-white dark:bg-slate-900 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 hover:border-blue-500/20 transition-all duration-300 relative [transform:translateZ(0)]">

    {/* Preview Container */}
    <div class="relative aspect-video bg-slate-100 dark:bg-slate-800 overflow-hidden rounded-t-2xl">

      {/* Browser Chrome */}
      <div class="absolute top-0 left-0 right-0 z-20 flex items-center gap-1.5 px-3 py-2 bg-slate-200 dark:bg-slate-700 border-b border-slate-300 dark:border-slate-600">
        <div class="flex gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
        </div>
        <span class="text-[9px] font-medium text-slate-500 dark:text-slate-400 truncate flex-1 mx-2">
          {new URL(src).hostname}
        </span>
        <button
          type="button"
          class="refresh-btn p-1 rounded hover:bg-slate-300 dark:hover:bg-slate-600 transition-colors"
          aria-label="Refresh"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
      </div>

      <div class="absolute inset-0 pt-8 overflow-hidden rounded-b-2xl">
        <iframe
          src={cleanedSrc}
          data-src={cleanedSrc}
          class="border-0 bg-white"
          style={`position: absolute; top: 0; left: 0; width: ${previewWidth}%; height: ${previewWidth}%; transform: scale(${scale}); transform-origin: top left;`}
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-modals"
          loading={loading}
          referrerpolicy="no-referrer"
          title={`${title} preview`}
        ></iframe>

        {/* Loading */}
        <div class="absolute inset-0 flex items-center justify-center bg-slate-100 dark:bg-slate-800 loading-state">
          <div class="flex flex-col items-center gap-2">
            <div class="w-6 h-6 border-2 border-slate-300 dark:border-slate-600 border-t-blue-500 rounded-full animate-spin"></div>
            <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400" data-i18n="projectcard.loading">Loading...</span>
          </div>
        </div>

        {/* Fallback */}
        <a href={src} target="_blank" rel="noopener noreferrer" class="hidden absolute inset-0 items-center justify-center bg-slate-50 dark:bg-slate-900 fallback-link">
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-purple-600 dark:text-purple-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span class="text-xs font-semibold text-slate-600 dark:text-slate-400" data-i18n="projectcard.open_website">Open Website</span>
          </div>
        </a>
      </div>
    </div>

    {/* Content */}
    <div class="p-4">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        {title}
      </h3>

      {description && (
        <p data-i18n-time={timeCount ? '' : undefined} data-count={timeCount || ''} data-unit={timeUnit || ''} class="text-slate-500 dark:text-slate-400 text-sm mt-2 mb-3 leading-relaxed line-clamp-2">
          {description}
        </p>
      )}

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
             <span class="text-[9px] font-bold px-3 py-1 bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-500/20 rounded-lg uppercase tracking-widest transition-colors group-hover:border-blue-500/40">
                {tag}
             </span>
          ))}
        </div>
      )}

      <div class="flex gap-2 mt-4">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold bg-slate-900 dark:bg-white dark:text-slate-900 text-white rounded-xl hover:-translate-y-0.5 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span data-i18n="projectcard.visit_live">Visit Live</span>
          </a>
        )}
        {detailUrl && (
          <a href={detailUrl} class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span data-i18n="projectcard.details">Details</span>
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll('.project-card').forEach(card => {
    const iframe = card.querySelector('iframe') as HTMLIFrameElement;
    const loading = card.querySelector('.loading-state');
    const refreshBtn = card.querySelector('.refresh-btn');

    const hideLoading = () => loading?.classList.add('hidden');

    setTimeout(hideLoading, 1500);

    iframe?.addEventListener('load', hideLoading);
    iframe?.addEventListener('error', hideLoading);

    refreshBtn?.addEventListener('click', () => {
      loading?.classList.remove('hidden');
      iframe.src = '';
      setTimeout(() => { iframe.src = iframe.dataset.src || '' }, 100);
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .loading-state.hidden {
    display: none;
  }

  .fallback-link.hidden {
    display: none;
  }

  .fallback-link:not(.hidden) {
    display: flex;
  }

  /* Make iframe always visible - handle in JS for load events */
  .project-card iframe {
    opacity: 1 !important;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>

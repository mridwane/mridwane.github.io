---
import "../styles/global.css";
import GridPattern from "../components/GridPattern.astro";

interface Props {
  title?: string;
}

const { title = "mridwane | Fullstack Developer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        const theme = (function() {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        })();

        document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');

        if (typeof localStorage !== 'undefined') {
          new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        }
      })();

      (function() {
        if (typeof localStorage !== 'undefined') {
          var lang = localStorage.getItem('lang') || 'en';
          document.documentElement.lang = lang;
        }
      })();
    </script>
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased">
    <GridPattern />
    <slot />
    <script>
      import AOS from "aos";
      import { translations, type Lang } from "../i18n/translations";

      AOS.init({
        once: false,
        offset: 100,
        duration: 1000,
        easing: 'ease-out-cubic',
        mirror: false
      });

      window.addEventListener('hashchange', () => {
        setTimeout(() => AOS.refresh(), 500);
      });

      window.addEventListener('theme-toggle', () => {
        setTimeout(() => AOS.refresh(), 150);
      });

      function applyTranslations() {
        const lang = (localStorage.getItem('lang') || 'en') as Lang;
        const elements = document.querySelectorAll('[data-i18n]');

        elements.forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const translation = translations[key]?.[lang];
          if (!translation) return;

          let text = translation;
          if (text.includes('{yearsExp}')) {
            const startYear = 2022;
            const yearsExp = new Date().getFullYear() - startYear;
            text = text.replace(/\{yearsExp\}/g, String(yearsExp));
          }

          if (text.includes('<')) {
            el.innerHTML = text;
          } else {
            el.textContent = text;
          }
        });

        const timeElements = document.querySelectorAll('[data-i18n-time]');
        timeElements.forEach((el) => {
          const count = el.getAttribute('data-count');
          const unit = el.getAttribute('data-unit');
          if (!count || !unit) return;
          const updateText = lang === 'id' ? 'Diperbarui' : 'Updated';
          const agoText = lang === 'id' ? 'lalu' : 'ago';
          el.textContent = `${updateText} ${count} ${unit} ${agoText}`;
        });
      }

      applyTranslations();
      window.addEventListener('language-toggle', applyTranslations);
    </script>
  </body>
</html>
---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Kontak | mridwane">
  <Navbar />

  <main class="pt-32 pb-24 relative overflow-hidden">

    <section class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span data-i18n="kontak.badge" class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 rounded-full mb-6 border border-blue-100 dark:border-blue-800">
          Contact
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tighter">
          <span class="inline-block bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2">
            <span data-i18n="kontak.heading">Get In <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300">Touch</span></span>
          </span>
        </h1>
        <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg mx-auto">
          <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-relaxed">
            <span data-i18n="kontak.desc">Have questions, want to collaborate, or just chat? Feel free to reach out to me through any of the channels below.</span>
          </span>
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto mb-16">
        <div class="group block" data-aos="fade-up">
          <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl transition-all duration-300 relative [transform:translateZ(0)]">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 bg-blue-50 dark:bg-blue-900/20 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-400 dark:text-slate-500 mb-1" data-i18n="kontak.address_label">Address</p>
                <p class="text-base font-bold text-slate-900 dark:text-white">Serang, Banten</p>
              </div>
            </div>
          </div>
        </div>

        <a href="mailto:eryansahm@gmail.com" class="group block" data-aos="fade-up" data-aos-delay="100">
          <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl hover:border-blue-500/20 transition-all duration-300 relative [transform:translateZ(0)]">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 bg-blue-50 dark:bg-blue-900/20 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-400 dark:text-slate-500 mb-1" data-i18n="kontak.email_label">Email</p>
                <p class="text-base font-bold text-slate-900 dark:text-white break-all">eryansahm@gmail.com</p>
              </div>
              <div class="ml-auto shrink-0 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-slate-600 group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </div>
            </div>
          </div>
        </a>

        <a href="https://wa.me/6285811591772" target="_blank" rel="noopener noreferrer" class="group block" data-aos="fade-up" data-aos-delay="200">
          <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl hover:border-green-500/20 transition-all duration-300 relative [transform:translateZ(0)]">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 bg-green-50 dark:bg-green-900/20 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-green-600 dark:text-green-400" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-400 dark:text-slate-500 mb-1" data-i18n="kontak.whatsapp_label">WhatsApp</p>
                <p class="text-base font-bold text-slate-900 dark:text-white">0858-1159-1772</p>
              </div>
              <div class="ml-auto shrink-0 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-slate-600 group-hover:text-green-500 dark:group-hover:text-green-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </div>
            </div>
          </div>
        </a>

        <a href="https://instagram.com/reryansahh" target="_blank" rel="noopener noreferrer" class="group block" data-aos="fade-up" data-aos-delay="300">
          <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl hover:border-pink-500/20 transition-all duration-300 relative [transform:translateZ(0)]">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 bg-pink-50 dark:bg-pink-900/20 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-pink-600 dark:text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <circle cx="12" cy="12" r="5" />
                  <circle cx="17.5" cy="6.5" r="1.5" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-400 dark:text-slate-500 mb-1" data-i18n="kontak.instagram_label">Instagram</p>
                <p class="text-base font-bold text-slate-900 dark:text-white group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors">@reryansahh</p>
              </div>
              <div class="ml-auto shrink-0 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 dark:text-slate-600 group-hover:text-pink-500 dark:group-hover:text-pink-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>

    </section>
  </main>

  <Footer />
</MainLayout>

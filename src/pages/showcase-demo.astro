---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GridPattern from '../components/GridPattern.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'Marine Optix',
    description: 'Website platform for marine optics products with modern design and user-friendly interface.',
    src: 'https://marine-optix.vercel.app',
    tags: ['Next.js', 'React', 'Tailwind'],
    liveUrl: 'https://marine-optix.vercel.app',
    detailUrl: '#',
    aspectRatio: '16/9' as const
  },
  {
    title: 'Movieku',
    description: 'Movie discovery platform with ratings and reviews.',
    src: 'https://movieku-mu.vercel.app',
    tags: ['Next.js', 'API', 'TMDB'],
    liveUrl: 'https://movieku-mu.vercel.app',
    detailUrl: '#',
    aspectRatio: '16/9' as const
  }
];
---

<MainLayout title="Showcase | DevPorto">
  <Navbar />

  <main class="pt-32 pb-24 relative overflow-hidden">
    <GridPattern />

    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-purple-50 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400 rounded-full mb-6 border border-purple-100 dark:border-purple-800">
          Portfolio
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tighter">
          Project <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-500 dark:from-purple-400 dark:to-pink-300">Showcase</span>
        </h1>
        <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg mx-auto">
          Live preview of my projects deployed on Vercel.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {projects.map((project, index) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            src={project.src}
            tags={project.tags}
            liveUrl={project.liveUrl}
            detailUrl={project.detailUrl}
            delay={index * 100}
            aspectRatio={project.aspectRatio}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>
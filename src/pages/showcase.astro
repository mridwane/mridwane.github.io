---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GridPattern from '../components/GridPattern.astro';

const getTheme = () => {
  if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
    return localStorage.getItem('theme');
  }
  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
};

const VERCEL_API_URL = 'https://api.github.com/users/mridwane/repos';
const response = await fetch(VERCEL_API_URL, {
  headers: {
    'Accept': 'application/vnd.github.v3+json'
  }
});
const repos = response.ok ? await response.json() : [];

const sortedRepos = repos
  .filter(repo => !repo.fork && !repo.archived)
  .sort((a, b) => new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime())
  .slice(0, 12);
---

<MainLayout title="Showcase | DevPorto">
  <Navbar />

  <main class="pt-32 pb-24 relative overflow-hidden">
    <GridPattern />

    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-purple-50 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400 rounded-full mb-6 border border-purple-100 dark:border-purple-800">
          Hobby Projects
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tighter">
          Showcase <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-500 dark:from-purple-400 dark:to-pink-300">Hobi</span>
        </h1>
        <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg mx-auto">
          Kumpulan project open source dan hobi yang saya kembangkan di waktu luang.
        </p>
      </div>

      {sortedRepos.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedRepos.map((repo, index) => (
            <a 
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
              data-aos="fade-up"
              data-aos-delay={String(index * 50)}
            >
              <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200 dark:border-purple-500/10 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/10 hover:-translate-y-1 h-full">
                <div class="flex items-start justify-between mb-4">
                  <div class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-lg uppercase tracking-wider">
                    {repo.language || 'Code'}
                  </span>
                </div>

                <h3 class="text-lg font-black mb-2 text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {repo.name}
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm mb-4 line-clamp-2">
                  {repo.description || 'No description available'}
                </p>

                <div class="flex items-center gap-4 text-xs text-slate-400 dark:text-slate-500 mt-auto">
                  <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                    {repo.stargazers_count}
                  </div>
                  <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.33m0 2.31a4.998 4.998 0 011.664-2.81 5.01 5.01 0 011.664-2.81c.48-1.394.673-2.891.673-4.431m0 9.18V19a2 2 0 01-2 2H7a2 2 0 01-2-2v-5.82m9.18 0A5.002 5.002 0 0113 8.1c.282.375.51.792.67 1.227m0-3.66V4.5a2 2 0 10-4 0v2.66m0 0A5 5 0 002.5 12m9 5.18a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    {repo.forks_count}
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-slate-500 dark:text-slate-400">Belum ada project hobi. Cek lagi nanti!</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</MainLayout>
---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { API_CONFIG } from '../config/index';

const VERCEL_TOKEN = import.meta.env.VERCEL_TOKEN;

const response = await fetch(`${API_CONFIG.VERCEL.BASE_URL}?limit=${API_CONFIG.VERCEL.LIMIT}`, {
  headers: {
    'Authorization': `Bearer ${VERCEL_TOKEN}`,
    'Content-Type': 'application/json'
  }
});

const data = response.ok ? await response.json() : { projects: [] };
const vercelProjects = data.projects || [];

const projects = vercelProjects.map((p: typeof vercelProjects[0]) => {
  const latestDep = p.latestDeployments?.[0];
  const url = latestDep?.alias?.[0] ? `https://${latestDep.alias[0]}` : latestDep?.url ? `https://${latestDep.url}` : '';
  return {
    title: p.name,
    src: url,
    description: latestDep?.meta?.githubCommitMessage || 'Deployed on Vercel',
    tags: [p.framework || 'Next.js'],
    liveUrl: url,
  };
}).filter(p => p.src).slice(0, API_CONFIG.VERCEL.LIMIT);
---

<MainLayout title="Showcase | DevPorto">
  <Navbar />

  <main class="pt-32 pb-24 relative overflow-hidden">

    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 rounded-full mb-6 border border-blue-100 dark:border-blue-800">
          Portfolio
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tighter">
          <span class="inline-block bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2">
            Showcase <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300">Projects</span>
          </span>
        </h1>
        <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg mx-auto">
          <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-relaxed">
            Eksplorasi ide dan kreativitas melalui koleksi proyek hobi saya. Halaman ini menampilkan berbagai eksperimen teknis dan solusi kreatif yang saya bangun di waktu luang.
          </span>
        </p>
      </div>

      {projects.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-8">
          {projects.map((project, index) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              src={project.src}
              tags={project.tags}
              liveUrl={project.liveUrl}
              delay={index * 100}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-slate-500 dark:text-slate-400">No projects found. Deploy your first project to Vercel!</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</MainLayout>

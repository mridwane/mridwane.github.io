---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { API_CONFIG } from '../config/index';

const VERCEL_TOKEN = import.meta.env.VERCEL_TOKEN;

const response = await fetch(`${API_CONFIG.VERCEL.BASE_URL}?limit=${API_CONFIG.VERCEL.LIMIT}`, {
  headers: {
    'Authorization': `Bearer ${VERCEL_TOKEN}`,
    'Content-Type': 'application/json'
  }
});

const data = response.ok ? await response.json() : { projects: [] };
const vercelProjects = data.projects || [];

const projects = vercelProjects.map((p: typeof vercelProjects[0]) => {
  const latestDep = p.latestDeployments?.[0];
  const url = latestDep?.alias?.[0] ? `https://${latestDep.alias[0]}` : latestDep?.url ? `https://${latestDep.url}` : '';

  const lastUpdated = latestDep?.readyAt || latestDep?.createdAt;
  let description = '';
  let timeCount = '';
  let timeUnit = '';
  if (lastUpdated) {
    const diff = Date.now() - new Date(lastUpdated).getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor(diff / (1000 * 60));
    if (days > 30) {
      const months = Math.floor(days / 30);
      timeCount = String(months);
      timeUnit = months > 1 ? 'months' : 'month';
      description = `Updated ${months} month${months > 1 ? 's' : ''} ago`;
    } else if (days > 0) {
      timeCount = String(days);
      timeUnit = days > 1 ? 'days' : 'day';
      description = `Updated ${days} day${days > 1 ? 's' : ''} ago`;
    } else if (hours > 0) {
      timeCount = String(hours);
      timeUnit = hours > 1 ? 'hours' : 'hour';
      description = `Updated ${hours} hour${hours > 1 ? 's' : ''} ago`;
    } else {
      timeCount = String(minutes);
      timeUnit = minutes > 1 ? 'minutes' : 'minute';
      description = `Updated ${minutes} minute${minutes > 1 ? 's' : ''} ago`;
    }
  }

  return {
    title: p.name,
    src: url,
    description,
    timeCount,
    timeUnit,
    tags: [p.framework || 'Next.js'],
    liveUrl: url,
  };
}).filter(p => p.src).slice(0, API_CONFIG.VERCEL.LIMIT);
---

<MainLayout title="Showcase | mridwane">
  <Navbar />

  <main class="pt-32 pb-24 relative overflow-hidden">

    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span data-i18n="showcase.badge" class="inline-block px-4 py-1 text-[10px] font-bold tracking-[0.3em] uppercase bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 rounded-full mb-6 border border-blue-100 dark:border-blue-800">
          Portfolio
        </span>
        <h1 class="text-5xl md:text-6xl font-black mb-6 tracking-tighter">
          <span class="inline-block bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2">
            <span data-i18n="showcase.heading">Showcase <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300">Projects</span></span>
          </span>
        </h1>
        <p class="max-w-2xl text-slate-500 dark:text-slate-400 text-lg mx-auto">
          <span class="[box-decoration-break:clone] bg-white/20 dark:bg-slate-950/20 backdrop-blur-lg px-6 py-2 leading-relaxed">
            <span data-i18n="showcase.desc">Explore ideas and creativity through my collection of hobby projects. This page showcases various technical experiments and creative solutions I built in my spare time.</span>
          </span>
        </p>
      </div>

      {projects.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-8">
          {projects.map((project, index) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              src={project.src}
              tags={project.tags}
              liveUrl={project.liveUrl}
              delay={index * 100}
              timeCount={project.timeCount}
              timeUnit={project.timeUnit}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p data-i18n="showcase.empty" class="text-slate-500 dark:text-slate-400">No projects found. Deploy your first project to Vercel!</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</MainLayout>
